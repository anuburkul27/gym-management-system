@model List<GymManagementSystem.Models.Member>

<h1>Members</h1>

<a asp-action="Create" class="btn btn-success">
    Add Member
</a>

<form asp-action="Index">
    <input type="text" name="searchString" />

    <button type="submit"
            class="btn btn-dark">
        Search
    </button>
</form>

<br />

<table class="table table-bordered">

    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Phone</th>
        <th>Membership</th>
        <th>Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Phone</td>
            <td>@item.MembershipType</td>

            <td>

                <a asp-action="Edit"
                   asp-route-id="@item.Id"
                   class="btn btn-primary">
                    Edit
                </a>

                <a asp-action="Delete"
                   asp-route-id="@item.Id"
                   class="btn btn-danger">
                    Delete
                </a>

                <a asp-action="Details"
                   asp-route-id="@item.Id"
                   class="btn btn-info">
                    Details
                </a>

            </td>
        </tr>
    }

</table>